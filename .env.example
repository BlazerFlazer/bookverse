# Скопируйте этот файл в .env (copy .env.example .env). Файл .env в git не попадает.

# --- Сервер ---
SERVER_PORT=4000
# Абсолютный или относительный к apps/server/prisma путь к базе SQLite
DATABASE_URL="file:./bookverse.db?connection_limit=1"
# Адрес сайта: на него ведут ссылки из бота. Для теста с телефона укажите публичный HTTPS-адрес.
PUBLIC_WEB_URL=http://localhost:5173
# production включает cookie с флагом Secure (нужен HTTPS)
NODE_ENV=development

# --- Telegram (необязательно: сайт работает и без бота) ---
# Токен выдаёт @BotFather. Без токена запускайте локальный симулятор: npm run bot:sim
TELEGRAM_BOT_TOKEN=
# Имя бота без @: нужно для ссылки привязки аккаунта
TELEGRAM_BOT_USERNAME=
# Общий секрет между ботом и сервером. Придумайте длинную случайную строку.
BOT_INTERNAL_SECRET=change-me-to-a-long-random-string
# Адрес сервера для бота
BOOKVERSE_API_URL=http://localhost:4000

# --- Словарь ---
# Викисловарь (CC BY-SA) как резервный источник определений. off — только словарь BOOKVERSE.
WIKTIONARY_LOOKUP=on

# --- Почта (необязательно). Пока не заполнено, письма не отправляются и сайт честно об этом говорит ---
SMTP_URL=
MAIL_FROM=

# --- Demo Day ---
# Ключ ведущего для страницы /demo. Придумайте его сами. Пока ключ пуст, режим ведущего выключен.
DEMO_PRESENTER_KEY=
# Адрес сайта для QR-кода. Если пусто, сервер подставит адрес этого компьютера в локальной сети.
# Заполните, если QR ведёт не туда, например http://192.168.1.11:5173
DEMO_PUBLIC_URL=
